# Configuración de Supabase
# 1. Creá tu proyecto gratuito en https://supabase.com
# 2. Copiá la URL del proyecto y la Anon Key de Configuración > API
# 3. Activá el proveedor de Google en Authentication > Providers > Google
# 4. Renombrá este archivo a .env.local

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
